# Kopiere diese Datei zu ".env.local" und trage dort deine echten Test-Schlüssel ein.
# ".env.local" wird NIE hochgeladen oder geteilt (siehe .gitignore).

# Google Gemini API Key (aus Google AI Studio)
GEMINI_API_KEY=

# Stripe TEST-Schlüssel (aus dem Stripe-Dashboard, Testmodus, "Entwickler" -> "API-Schlüssel")
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Wird beim lokalen Testen mit der Stripe CLI erzeugt (siehe README)
STRIPE_WEBHOOK_SECRET=whsec_...

# Lokal immer so lassen:
APP_URL=https://kivideostudio.de

# Seedance Video-Rendering über fal.ai
FAL_KEY=
SEEDANCE_WORKFLOW_RENDER_ENABLED=false

# Alte Veo-Pipeline deaktiviert lassen
VEO_WORKFLOW_RENDER_ENABLED=false
LEGACY_VEO_ROUTES_ENABLED=false

# Produktion: dauerhafter Job-Speicher (Upstash Redis)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Produktion: privater Vercel-Blob-Speicher für fertige Videos.
# Lokal nutzt die Anwendung automatisch einen privaten Dateisystem-Fallback.
BLOB_READ_WRITE_TOKEN=
BLOB_STORE_ID=

# Song generation via AceData / Suno
ACEDATA_API_KEY=
ACEDATA_SUNO_MODEL=chirp-v5-5

# Signiert die sichere Song-Studio-Sitzung. In Produktion einen langen Zufallswert setzen.
# Ohne eigenen Wert wird vorübergehend STRIPE_SECRET_KEY zum Signieren verwendet.
SONG_SUBSCRIPTION_SECRET=
